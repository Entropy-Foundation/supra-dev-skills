# ─── Supra Multiwallet Skill — Required Environment Variables ────────────────
#
# Copy this file to .env.local in your Next.js project and fill in the values.
# Never commit .env.local to version control.
#
# Quick setup:
#   cp .env.local.example .env.local
#   # then edit .env.local with your values
# ─────────────────────────────────────────────────────────────────────────────


# ── JWT Secret ────────────────────────────────────────────────────────────────
# Used to sign and verify authentication JWTs (sign-in-with-wallet flow).
# Must be a long random string — 64+ bytes of hex is recommended.
# Required if using the JWT auth flow. If not using auth, set any placeholder
# value to prevent lib/auth.ts from throwing on import.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
JWT_SECRET=replace_with_64_plus_char_random_hex_string


# ── App URL ───────────────────────────────────────────────────────────────────
# The full origin of your app (no trailing slash).
# Used by the wallet auth API routes for CORS and cookie domain checks.
# Change to your production URL when deploying.
#
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Supra Chain ID ────────────────────────────────────────────────────────────
# IMPORTANT: This MUST be a string, not a number.
# The hook does a strict string comparison against the chain ID returned by
# the wallet provider. If you set this to the integer 6 instead of the
# string "6", network detection silently breaks.
#
# Allowed values:
#   "6"  — Supra Testnet  (https://rpc-testnet.supra.com)
#   "8"  — Supra Mainnet  (https://rpc-mainnet.supra.com)
#
NEXT_PUBLIC_SUPRA_CHAIN_ID="6"
